DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/boardvote
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
MAIL_FROM=YWI Board Votes <vote@yubawatershedinstitute.org>
ADMIN_EMAILS=chris@yubawatershedinstitute.org
# RESEND_API_KEY unset locally: magic links, close notices, and reminders are printed to the server log instead of emailed
# CRON_SECRET: set on Vercel so only Vercel Cron can run /api/cron/reminders (a signed-in admin can always open it)
# REMINDER_AFTER_DAYS=2 and REMINDER_EVERY_DAYS=3 tune the vote reminders; see SETUP.md
# Board roster, seeded only when the members table is empty. Keys are stable handles used by imports.
BOARD_ROSTER=[{"key":"chris","email":"director@example.org","name":"Executive Director (ED)","admin":true,"voting":false},{"key":"daniel","email":"chair@example.org","name":"Board Chair","admin":true,"voting":true}]
